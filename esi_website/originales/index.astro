---
import SiteLayout from '../layouts/SiteLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ArrowDown, ArrowRight, ArrowUpRight, BarChart3, Boxes, Building2, Check, ChevronRight, CircleHelp, ClipboardCheck, Cloud, Database, Factory, Headset, Layers3, LineChart, MapPin, Network, PackageCheck, Phone, Settings2, ShieldCheck, ShoppingCart, Sparkles, Truck, Users, Workflow } from '@lucide/astro';

const modules = [
  { name: 'Ventas', desc: 'Cotizaciones, pedidos y seguimiento comercial en un solo flujo.', icon: ShoppingCart },
  { name: 'Compras', desc: 'Proveedores, solicitudes y abastecimiento bajo control.', icon: ClipboardCheck },
  { name: 'Inventario', desc: 'Existencias, trazabilidad y movimientos al día.', icon: Boxes },
  { name: 'Contabilidad', desc: 'Información financiera conectada con la operación.', icon: BarChart3 },
  { name: 'Manufactura', desc: 'Órdenes, materiales y planificación de producción.', icon: Factory },
  { name: 'Importaciones', desc: 'Costos, embarques y recepción con visibilidad.', icon: Truck },
  { name: 'Punto de venta', desc: 'Atención ágil en mostrador y sucursales.', icon: ShoppingCart },
  { name: 'Reportes', desc: 'Indicadores para decidir con información confiable.', icon: LineChart },
];
const serviceList = [
  { title: 'Implementación', body: 'Configuramos Odoo alrededor de tus procesos y prioridades.', icon: Settings2 },
  { title: 'Desarrollo e integración', body: 'Personalizamos funciones e integramos herramientas de tu operación.', icon: Network },
  { title: 'Hosting y continuidad', body: 'Alojamiento, actualizaciones y respaldo para trabajar con tranquilidad.', icon: Cloud },
  { title: 'Capacitación y soporte', body: 'Acompañamos a tu equipo para que cada módulo se use de verdad.', icon: Headset },
];
const steps = [
  { n: '01', title: 'Escuchamos', body: 'Entendemos tu operación, objetivos y puntos de fricción.' },
  { n: '02', title: 'Priorizamos', body: 'Definimos un alcance claro y elegimos el primer módulo.' },
  { n: '03', title: 'Configuramos', body: 'Adaptamos Odoo y preparamos tus datos para el cambio.' },
  { n: '04', title: 'Acompañamos', body: 'Capacitamos al equipo y ponemos el sistema en marcha.' },
  { n: '05', title: 'Escalamos', body: 'Medimos, mejoramos y sumamos nuevas áreas cuando estés listo.' },
];
const sectors = [
  { name: 'Importadoras', icon: Truck, detail: 'Compras internacionales, costos y mercadería.' },
  { name: 'Distribuidoras', icon: PackageCheck, detail: 'Inventario, rutas comerciales y pedidos.' },
  { name: 'Agropecuarias', icon: Sparkles, detail: 'Operación, insumos y trazabilidad.' },
  { name: 'Manufactura', icon: Factory, detail: 'Producción, materiales y planificación.' },
  { name: 'Farmacias', icon: ShieldCheck, detail: 'Lotes, vencimientos y atención en caja.' },
  { name: 'Comercios', icon: Building2, detail: 'Ventas, punto de venta y sucursales.' },
];
const FORM_ID = '848fd984-b7d5-468e-be73-442f5b9db067';
---

<SiteLayout>
  <Header />
  <main>
    <section class="hero-section" id="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <div class="eyebrow"><span class="eyebrow-dot"></span> Odoo ERP · Santa Cruz, Bolivia</div>
          <h1>Integra tu empresa.<br />Controla mejor.<br /><span>Crece con información real.</span></h1>
          <p class="hero-lead">Conectamos tus áreas en un sistema que acompaña el ritmo de tu negocio, con implementación y soporte cercano en cada etapa.</p>
          <p class="hero-motto">Empieza por un módulo y escala a un sistema integrado.</p>
          <div class="hero-actions">
            <a class="button" href="/index#contacto">Solicita una asesoría <ArrowRight size={17} /></a>
            <a class="text-link" href="/index#soluciones">Explora las soluciones <ArrowDown size={16} /></a>
          </div>
          <div class="hero-proof"><span class="proof-icon"><Check size={15} /></span><span>Un equipo local para implementar, mejorar y acompañar tu Odoo.</span></div>
        </div>
        <div class="hero-visual">
          <div class="hero-image-frame">
            <img src="https://cdn.b12.io/client_media/p1LsgKDq/9707037a-c9d8-11f1-a92a-0242ac110002-editorial-corporate-photography-for-a-premium-bolivian-erp-s.jpg" alt="Responsable de operaciones revisando inventario en un centro de distribución" fetchpriority="high" />
            <div class="image-label"><span class="image-label-mark"><Workflow size={18} /></span><span><strong>Una operación conectada</strong><small>Visibilidad de punta a punta</small></span></div>
          </div>
          <div class="hero-side-note"><span class="side-line"></span><span>Tu negocio, con la información en el lugar correcto.</span></div>
          <div class="floating-status"><span class="status-check"><Check size={15} /></span><span><strong>Todo en un solo flujo</strong><small>Ventas · Inventario · Finanzas</small></span></div>
        </div>
      </div>
      <div class="hero-bottom container"><span>Soluciones que se adaptan a cómo trabajas</span><a href="/index#problemas" aria-label="Conoce los desafíos de una operación desconectada"><ArrowDown size={16} /></a><span>De lo esencial a lo integrado</span></div>
    </section>

    <section class="problem-section section-pad" id="problemas">
      <div class="container problem-grid">
        <div class="section-heading">
          <span class="eyebrow">Cuando la operación no se conecta</span>
          <h2>¿Te cuesta ver lo que realmente pasa en tu empresa?</h2>
          <p>La información dispersa convierte tareas simples en trabajo doble. Un sistema integrado ordena los procesos y hace que los datos vuelvan a servir para decidir.</p>
          <a class="text-link" href="/index#soluciones">Conoce los módulos Odoo <ArrowRight size={16} /></a>
        </div>
        <div class="pain-list">
          <article class="pain-item"><span class="pain-number">01</span><div><h3>Datos en varios lugares</h3><p>Hojas de cálculo, mensajes y sistemas que no comparten la misma versión.</p></div><CircleHelp size={20} /></article>
          <article class="pain-item"><span class="pain-number">02</span><div><h3>Procesos que dependen de una persona</h3><p>Seguimientos manuales que hacen difícil mantener el ritmo y la continuidad.</p></div><CircleHelp size={20} /></article>
          <article class="pain-item"><span class="pain-number">03</span><div><h3>Decisiones con información tardía</h3><p>Sin una vista común, cuesta conocer existencias, márgenes y pendientes.</p></div><CircleHelp size={20} /></article>
        </div>
      </div>
    </section>

    <section class="solutions-section section-pad" id="soluciones">
      <div class="container">
        <div class="section-heading centered-heading">
          <span class="eyebrow">Soluciones modulares</span>
          <h2>Un sistema que crece al ritmo de tu empresa</h2>
          <p>Empieza donde más lo necesitas. Los módulos de Odoo trabajan conectados para que cada paso construya sobre el anterior.</p>
        </div>
        <div class="module-grid">
          {modules.map((item, index) => {
            const Icon = item.icon;
            return <article class="module-card"><div class="module-card-top"><span class="module-icon"><Icon size={21} strokeWidth={1.7} /></span><span class="module-index">0{index + 1}</span></div><h3>{item.name}</h3><p>{item.desc}</p><a href="/index#contacto" aria-label={`Consultar por el módulo de ${item.name}`}><ArrowUpRight size={17} /></a></article>;
          })}
        </div>
        <div class="module-note"><span class="note-line"></span><p>¿No sabes por dónde empezar? <a href="/index#contacto">Lo definimos contigo</a> a partir de tus prioridades.</p></div>
      </div>
    </section>

    <section class="benefits-section section-pad" id="beneficios">
      <div class="container benefits-grid">
        <div class="benefits-intro">
          <span class="eyebrow eyebrow-light">Más claridad para avanzar</span>
          <h2>Menos retrabajo.<br />Más control.</h2>
          <p>Odoo conecta la información que tu equipo necesita para trabajar con confianza y mirar hacia adelante.</p>
          <a class="button button-light" href="/index#contacto">Conversemos sobre tu empresa <ArrowRight size={17} /></a>
        </div>
        <div class="benefit-list">
          <article><span><Check size={17} /></span><div><h3>Una sola fuente de información</h3><p>Los equipos consultan datos coherentes y actualizados.</p></div></article>
          <article><span><Check size={17} /></span><div><h3>Procesos más claros</h3><p>Define responsables, aprobaciones y siguientes pasos.</p></div></article>
          <article><span><Check size={17} /></span><div><h3>Decisiones con contexto</h3><p>Accede a indicadores de tu operación sin esperar cierres manuales.</p></div></article>
          <article><span><Check size={17} /></span><div><h3>Crecimiento gradual</h3><p>Agrega nuevas áreas cuando tus necesidades y equipo estén listos.</p></div></article>
        </div>
      </div>
    </section>

    <section class="services-section section-pad" id="servicios">
      <div class="container">
        <div class="section-heading services-heading">
          <div><span class="eyebrow">Servicios ESI Bolivia</span><h2>Te acompañamos más allá de la configuración</h2></div>
          <p>Un proyecto ERP funciona cuando el sistema, las personas y la operación avanzan juntos. Estamos cerca antes, durante y después de la puesta en marcha.</p>
        </div>
        <div class="service-grid">
          {serviceList.map((service) => {
            const Icon = service.icon;
            return <article class="service-card"><span class="service-icon"><Icon size={22} strokeWidth={1.7} /></span><h3>{service.title}</h3><p>{service.body}</p><a href="/index#contacto">Conocer el servicio <ChevronRight size={15} /></a></article>;
          })}
        </div>
      </div>
    </section>

    <section class="process-section section-pad" id="proceso">
      <div class="container">
        <div class="section-heading centered-heading">
          <span class="eyebrow">Un proceso pensado para tu equipo</span>
          <h2>Avanzamos paso a paso, contigo</h2>
          <p>Una implementación clara, con decisiones compartidas y espacio para aprender en cada etapa.</p>
        </div>
        <div class="process-grid">
          {steps.map((step, index) => <article class="process-step"><div class="step-top"><span>{step.n}</span>{index < steps.length - 1 && <i aria-hidden="true"></i>}</div><h3>{step.title}</h3><p>{step.body}</p></article>)}
        </div>
      </div>
    </section>

    <section class="sectors-section section-pad" id="sectores">
      <div class="container sectors-grid">
        <div class="section-heading sectors-intro">
          <span class="eyebrow">Conocemos la operación</span>
          <h2>Experiencia para distintos sectores</h2>
          <p>Cada rubro tiene su propio ritmo. Configuramos el sistema para responder a las particularidades de tu operación, sin forzar procesos que no te sirven.</p>
          <a class="text-link" href="/index#contacto">Cuéntanos sobre tu rubro <ArrowRight size={16} /></a>
        </div>
        <div class="sector-list">
          {sectors.map((sector) => {
            const Icon = sector.icon;
            return <article class="sector-card"><span class="sector-icon"><Icon size={20} strokeWidth={1.7} /></span><div><h3>{sector.name}</h3><p>{sector.detail}</p></div><ArrowUpRight size={16} class="sector-arrow" /></article>;
          })}
        </div>
      </div>
    </section>

    <section class="odoo-section section-pad" id="odoo">
      <div class="container odoo-grid">
        <div class="odoo-copy">
          <span class="eyebrow eyebrow-light">Una plataforma integrada</span>
          <h2>¿Qué es Odoo?</h2>
          <p>Odoo es un conjunto de aplicaciones empresariales que comparten información: ventas, compras, inventario, contabilidad, manufactura y más. En lugar de sumar herramientas aisladas, puedes comenzar con lo necesario y ampliar con una base común.</p>
          <div class="odoo-points"><span><Check size={16} /> Aplicaciones conectadas entre sí</span><span><Check size={16} /> Adaptable a distintos procesos</span><span><Check size={16} /> Modular para crecer por etapas</span></div>
          <p class="odoo-role"><strong>El papel de ESI Bolivia:</strong> traducimos las necesidades de tu empresa en una solución práctica, configuramos Odoo y acompañamos a tu equipo para adoptarlo con confianza.</p>
          <a class="button button-light" href="/index#contacto">Evalúa si Odoo encaja contigo <ArrowRight size={17} /></a>
        </div>
        <div class="odoo-visual" role="img" aria-label="Representación de aplicaciones Odoo conectadas">
          <div class="odoo-orbit orbit-one"></div><div class="odoo-orbit orbit-two"></div>
          <div class="odoo-center"><span class="odoo-center-symbol"><Layers3 size={28} /></span><strong>Odoo</strong><small>Una plataforma</small></div>
          <div class="orbit-node node-sales"><ShoppingCart size={17} /><span>Ventas</span></div>
          <div class="orbit-node node-stock"><Boxes size={17} /><span>Inventario</span></div>
          <div class="orbit-node node-books"><BarChart3 size={17} /><span>Finanzas</span></div>
          <div class="orbit-node node-people"><Users size={17} /><span>Equipo</span></div>
        </div>
      </div>
    </section>

    <section class="insights-section section-pad" id="reportes">
      <div class="container insight-grid">
        <div class="dashboard-window" role="img" aria-label="Ejemplo ilustrativo de tablero de reportes de Odoo">
          <div class="dashboard-top"><div class="window-dots"><i></i><i></i><i></i></div><span>Resumen de operación</span><span class="dashboard-period">Este mes <ChevronRight size={13} /></span></div>
          <div class="dashboard-content">
            <div class="dashboard-title"><div><span>Panel de control</span><h3>Visión general</h3></div><span class="dash-avatar">ES</span></div>
            <div class="metric-grid">
              <div class="metric-card"><small>Ventas del mes</small><strong>Bs. 248.6k</strong><span class="metric-positive"><ArrowUpRight size={13} /> Tendencia al alza</span></div>
              <div class="metric-card"><small>Pedidos abiertos</small><strong>36</strong><span class="metric-label">En seguimiento</span></div>
              <div class="metric-card"><small>Stock disponible</small><strong>92%</strong><span class="metric-label">Inventario conectado</span></div>
            </div>
            <div class="chart-card"><div class="chart-heading"><span>Actividad comercial</span><small>Últimos 6 meses</small></div><div class="chart-bars" aria-hidden="true"><i class="bar-one"></i><i class="bar-two"></i><i class="bar-three"></i><i class="bar-four"></i><i class="bar-five"></i><i class="bar-six"></i><i class="bar-seven"></i><i class="bar-eight"></i></div><div class="chart-labels"><span>Mar</span><span>Abr</span><span>May</span><span>Jun</span><span>Jul</span><span>Ago</span></div></div>
            <div class="dashboard-foot"><span><span class="live-dot"></span> Información integrada</span><span>Ejemplo ilustrativo</span></div>
          </div>
        </div>
        <div class="insight-copy">
          <span class="eyebrow">Información útil, a tiempo</span>
          <h2>De los movimientos diarios a una visión completa</h2>
          <p>Los reportes de Odoo reúnen la actividad de ventas, inventario y finanzas. Así puedes observar tendencias y pendientes desde una misma plataforma.</p>
          <div class="insight-features">
            <article><span><LineChart size={20} /></span><div><h3>Reportes para decidir</h3><p>Revisa los datos relevantes para tu negocio y profundiza cuando lo necesites.</p></div></article>
            <article><span><Building2 size={20} /></span><div><h3>Operación multisucursal</h3><p>Organiza equipos, almacenes y puntos de venta con una visión común.</p></div></article>
            <article><span><Database size={20} /></span><div><h3>Contexto compartido</h3><p>Conecta transacciones y seguimiento para entender qué está pasando.</p></div></article>
          </div>
          <a class="text-link" href="/index#contacto">Conversemos sobre tus reportes <ArrowRight size={16} /></a>
        </div>
      </div>
    </section>

    <section class="about-section section-pad" id="nosotros">
      <div class="container about-grid">
        <div class="about-mark" aria-hidden="true"><div class="about-monogram">ESI<span>.</span></div><div class="about-caption">Especialistas en<br />Sistemas Integrados</div><div class="about-lines"><i></i><i></i><i></i></div></div>
        <div class="about-copy">
          <span class="eyebrow">Cerca de tu operación</span>
          <h2>Somos ESI Bolivia</h2>
          <p>ESI Bolivia (Especialistas en Sistemas Integrados) es una empresa de Santa Cruz de la Sierra enfocada en ayudar a las organizaciones a implementar y aprovechar Odoo ERP.</p>
          <p>Combinamos conocimiento de procesos, configuración y desarrollo con una forma de trabajo cercana. Nuestro objetivo es que la tecnología resuelva necesidades concretas y evolucione junto con tu empresa.</p>
          <div class="about-values"><span><span class="value-dot"></span> Acompañamiento local</span><span><span class="value-dot"></span> Soluciones por etapas</span><span><span class="value-dot"></span> Foco en procesos reales</span></div>
          <a class="text-link" href="/index#contacto">Hablemos de tu proyecto <ArrowRight size={16} /></a>
        </div>
      </div>
    </section>

    <section class="contact-section section-pad" id="contacto">
      <div class="container contact-grid">
        <div class="contact-copy">
          <span class="eyebrow eyebrow-light">El siguiente paso puede ser pequeño</span>
          <h2>Cuéntanos qué quieres mejorar</h2>
          <p>Comparte un poco sobre tu empresa y tus prioridades. Revisaremos contigo qué módulo o proceso podría ser un buen punto de partida.</p>
          <div class="contact-methods">
            <a href="https://wa.me/59177973584" target="_blank" rel="noopener noreferrer"><span class="contact-method-icon"><Phone size={18} /></span><span><small>WhatsApp</small><strong>+591 77973584</strong></span><ArrowUpRight size={16} /></a>
            <a href="mailto:contacto.esibolivia@gmail.com"><span class="contact-method-icon"><ArrowUpRight size={18} /></span><span><small>Correo electrónico</small><strong>contacto.esibolivia@gmail.com</strong></span><ArrowUpRight size={16} /></a>
            <span class="location-line"><MapPin size={17} /> Santa Cruz de la Sierra, Bolivia</span>
          </div>
        </div>
        <div class="contact-form-wrap">
          <div class="form-heading"><span>Solicitud de asesoría</span><small>Los campos marcados con <b>*</b> son obligatorios.</small></div>
          <form data-form-id={FORM_ID}>
            <div class="form-row">
              <label>Nombre <span>*</span><input type="text" name="nombre" autocomplete="name" placeholder="Tu nombre" required /></label>
              <label>Empresa <span>*</span><input type="text" name="empresa" autocomplete="organization" placeholder="Nombre de tu empresa" required /></label>
            </div>
            <div class="form-row">
              <label>Teléfono <span>*</span><input type="tel" name="telefono" autocomplete="tel" placeholder="+591" required /></label>
              <label>Correo electrónico <span>*</span><input type="email" name="correo" autocomplete="email" placeholder="nombre@empresa.com" required /></label>
            </div>
            <label>Rubro <span>*</span><select name="rubro" required><option value="" disabled selected>Selecciona tu rubro</option><option>Importadora</option><option>Distribuidora</option><option>Agropecuaria</option><option>Manufactura</option><option>Farmacia</option><option>Comercio</option></select></label>
            <label>¿Qué te gustaría mejorar? <span>*</span><textarea name="mensaje" rows="4" placeholder="Cuéntanos brevemente sobre tu operación y tus prioridades" required></textarea></label>
            <button class="button form-submit" type="submit">Solicitar asesoría <ArrowRight size={17} /></button>
            <p class="form-note">Al enviar, podremos contactarte para conversar sobre tu consulta.</p>
          </form>
          <div id={`b12-form-done-${FORM_ID}`} class="form-result form-result-success" hidden>Gracias por escribirnos. Nos pondremos en contacto contigo pronto.</div>
          <div id={`b12-form-error-${FORM_ID}`} class="form-result form-result-error" hidden>No se pudo enviar tu solicitud. Inténtalo de nuevo o escríbenos por WhatsApp.</div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</SiteLayout>
