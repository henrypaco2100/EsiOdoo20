<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="view_agro_accounting_flow_button" model="ir.ui.view">
  <field name="name">esi.agro.demo.wizard.operational.flow</field><field name="model">esi.agro.demo.wizard</field>
  <field name="inherit_id" ref="view_esi_agro_demo_wizard"/>
  <field name="arch" type="xml"><xpath expr="//footer/button[@name='action_load']" position="after">
    <button name="action_audit_operational_accounting" type="object" string="Revisar diarios y asientos" class="btn-secondary"/>
    <button name="action_posted_operational_entries" type="object" string="VER todas las operaciones contabilizadas" class="btn-secondary"/>
  </xpath></field>
 </record>
 <record id="action_agro_all_posted_entries" model="ir.actions.act_window">
  <field name="name">Asientos de operaciones (todos)</field><field name="res_model">account.move</field>
  <field name="view_mode">list,form</field><field name="domain">[('state','=','posted')]</field>
 </record>
 <record id="action_agro_all_sales_invoices" model="ir.actions.act_window">
  <field name="name">Facturas de ventas</field><field name="res_model">account.move</field>
  <field name="view_mode">list,form</field><field name="domain">[('move_type','in',['out_invoice','out_refund'])]</field>
 </record>
 <record id="action_agro_all_purchase_invoices" model="ir.actions.act_window">
  <field name="name">Facturas de compras</field><field name="res_model">account.move</field>
  <field name="view_mode">list,form</field><field name="domain">[('move_type','in',['in_invoice','in_refund'])]</field>
 </record>
 <menuitem id="menu_agro_all_posted_entries" name="Asientos de operaciones (todos)" parent="menu_esi_agro_reports" action="action_agro_all_posted_entries" groups="account.group_account_user" sequence="35"/>
 <menuitem id="menu_agro_all_sales_invoices" name="Facturas de ventas" parent="menu_esi_agro_reports" action="action_agro_all_sales_invoices" groups="account.group_account_user" sequence="36"/>
 <menuitem id="menu_agro_all_purchase_invoices" name="Facturas de compras" parent="menu_esi_agro_reports" action="action_agro_all_purchase_invoices" groups="account.group_account_user" sequence="37"/>
</odoo>