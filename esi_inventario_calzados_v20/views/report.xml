<odoo>
  <record id="inventory_form" model="ir.ui.view">
    <field name="name">esi.shoe.inventory.report.form</field>
    <field name="model">esi.shoe.inventory.report</field>
    <field name="arch" type="xml">
      <form string="Kardex por talla" class="o_esi_size_kardex_wide">
        <header><button name="action_preview" type="object" string="Consultar" class="btn-primary"/><button name="action_xlsx" type="object" string="Excel"/><button name="action_pdf" type="object" string="PDF"/></header>
        <sheet><group><group><field name="company_id"/><field name="warehouse_id" options="{'no_create': True}"/><field name="category_id" options="{'no_create': True}"/></group>
          <group><field name="template_id" options="{'no_create': True}"/><field name="size_attribute_id" options="{'no_create': True}"/><field name="quantity_type"/><field name="include_zero"/></group></group>
          <div class="alert alert-info">Inventario actual de productos marcados Fabricar. Cada columna corresponde a una talla; colores, modelos y materiales distintos se muestran en filas separadas. PU es el costo de la sucursal.</div>
          <div style="overflow-x:auto"><field name="preview" widget="html" nolabel="1"/></div>
        </sheet>
      </form>
    </field>
  </record>
  <record id="inventory_action" model="ir.actions.act_window"><field name="name">Kardex por talla</field><field name="res_model">esi.shoe.inventory.report</field><field name="view_mode">form</field></record>
  <menuitem id="inventory_menu" name="Kardex por talla" parent="stock.menu_warehouse_report" action="inventory_action" groups="stock.group_stock_manager" sequence="85"/>
</odoo>
