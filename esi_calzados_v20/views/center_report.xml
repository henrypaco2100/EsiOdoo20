<odoo>
  <record id="center_advance_company" model="ir.access">
    <field name="name">Avances de fabricación: compañías activas</field>
    <field name="model_id" ref="model_esi_center_advance"/>
    <field name="operation">crud</field>
    <field name="domain">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="center_advance_report_form" model="ir.ui.view">
    <field name="name">esi.center.advance.report.form</field>
    <field name="model">esi.center.advance.report</field>
    <field name="arch" type="xml">
      <form string="Matriz de producción por centro">
        <header><button name="action_preview" type="object" string="Actualizar tablero" class="btn-primary"/><button name="action_pivot" type="object" string="Tabla dinámica"/></header>
        <sheet>
          <group><group><field name="company_id"/><field name="grouping"/><field name="uom_id"/></group>
          <group><field name="date_from"/><field name="date_to"/></group></group>
          <p>Las columnas muestran la cantidad avanzada desde cada centro. El mismo par puede contarse en varias áreas; no sume las columnas como producto terminado. Las semanas comienzan el lunes. Solo se muestran períodos con avances registrados.</p>
          <field name="result_html" nolabel="1"/>
        </sheet>
      </form>
    </field>
  </record>
  <record id="center_advance_report_action" model="ir.actions.act_window">
    <field name="name">Matriz de producción por centro</field>
    <field name="res_model">esi.center.advance.report</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="center_advance_report_form"/>
  </record>
  <menuitem id="center_advance_report_menu" name="Matriz de producción por centro"
    parent="mrp.menu_mrp_manufacturing" action="center_advance_report_action"
    sequence="26" groups="mrp.group_mrp_user"/>
  <record id="center_advance_pivot" model="ir.ui.view">
    <field name="name">esi.center.advance.pivot</field>
    <field name="model">esi.center.advance</field>
    <field name="arch" type="xml">
      <pivot string="Avances por centro" disable_linking="1">
        <field name="advanced_at" type="row" interval="day"/>
        <field name="workcenter_id" type="col"/>
        <field name="quantity" type="measure"/>
      </pivot>
    </field>
  </record>
</odoo>
