<odoo>
  <record id="variant_grid_form" model="ir.ui.view"><field name="name">esi.variant.grid.form</field><field name="model">esi.variant.grid</field><field name="arch" type="xml"><form string="Cuadrícula de variantes"><group><field name="target_model" invisible="1"/><field name="target_id" invisible="1"/><field name="product_tmpl_id" options="{'no_create': True}"/><field name="target_bom_id" invisible="1"/><field name="operation_id" invisible="target_model not in ('mrp.bom', 'mrp.production')" options="{'no_create': True}"/></group><p>Las cantidades se agregan al documento. Cero no elimina líneas existentes. Unidad: la unidad de inventario de cada variante.</p><field name="grid_json" widget="esi_variant_grid" nolabel="1"/><footer><button name="action_apply" type="object" string="Agregar variantes" class="btn-primary"/><button string="Cancelar" special="cancel"/></footer></form></field></record>
  <record id="grid_group" model="ir.ui.view"><field name="name">esi.group.grid</field><field name="model">esi.production.group</field><field name="inherit_id" ref="view_esi_production_group_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_esi_variant_grid" type="object" string="Cuadrícula de variantes" invisible="state != 'draft'"/></xpath></field></record>
  <record id="grid_bom" model="ir.ui.view"><field name="active" eval="False"/><field name="name">mrp.bom.grid</field><field name="model">mrp.bom</field><field name="inherit_id" ref="mrp.mrp_bom_form_view"/><field name="arch" type="xml"><xpath expr="//sheet" position="before"><header><button name="action_esi_variant_grid" type="object" string="Componentes por cuadrícula" groups="mrp.group_mrp_manager"/></header></xpath></field></record>
  <record id="grid_picking" model="ir.ui.view"><field name="name">stock.picking.grid</field><field name="model">stock.picking</field><field name="inherit_id" ref="stock.view_picking_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_esi_variant_grid" type="object" string="Cuadrícula de variantes" invisible="state != 'draft'" groups="stock.group_stock_user"/></xpath></field></record>
  <record id="grid_production" model="ir.ui.view"><field name="active" eval="False"/><field name="name">mrp.production.grid</field><field name="model">mrp.production</field><field name="inherit_id" ref="mrp.mrp_production_form_view"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_esi_variant_grid" type="object" string="Componentes por cuadrícula" invisible="state != 'draft'" groups="mrp.group_mrp_user"/></xpath></field></record>
</odoo>
