<odoo>
  <record id="product_material_specification_form" model="ir.ui.view">
    <field name="name">product.template.material.specification</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//page[@name='general_information']" position="inside">
        <group string="Especificaciones del producto" name="esi_material_specification">
          <field name="esi_material_type"/>
          <field name="esi_measure"/>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
