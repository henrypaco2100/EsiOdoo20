<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_production_esi_v20" model="ir.ui.view">
        <field name="name">mrp.production.esi.v20</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="esi_plan_grid" invisible="1"/><field name="esi_variant_line_mode" invisible="1"/>
                <field name="esi_responsible_id"/>
                <field name="esi_group_id" readonly="1"/>
                <field name="esi_analytic_account_id"/>
            </field>
            <!-- Mantener visible el campo nativo: ahora es el total del lote. -->
            <xpath expr="//notebook" position="before">
                <field name="esi_size_batch" invisible="1"/>
                <field name="esi_batch_attribute_ids" invisible="1"/>
                <group string="Fabricación por tallas" invisible="esi_variant_line_mode or not esi_batch_attribute_ids or (esi_plan_grid and state == 'draft')">
                    <field name="esi_batch_description"/>
                    
                    <field name="esi_source_bom_id"/>
                    <field name="move_finished_ids" readonly="1" nolabel="1" colspan="2">
                        <list create="0" edit="0" delete="0"><field name="product_id"/><field name="product_uom_qty" string="Planificado"/><field name="quantity" string="Registrado"/><field name="uom_id"/></list>
                    </field>
                    <div colspan="2" class="text-muted">Registre las cantidades reales de todas las tallas antes de finalizar el lote.</div>
                </group>
            </xpath>
        </field>
    </record>
    <record id="production_total_sizes_list" model="ir.ui.view">
        <field name="name">mrp.production.total.sizes.list</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <field name="product_qty" position="attributes"><attribute name="string">Cantidad total a fabricar</attribute></field>
        </field>
    </record>
</odoo>
