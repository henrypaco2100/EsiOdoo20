<odoo>
  <record id="production_direct_size_plan" model="ir.ui.view">
    <field name="name">mrp.production.direct.size.plan</field><field name="model">mrp.production</field>
    <field name="inherit_id" ref="mrp.mrp_production_form_view"/><field name="priority">30</field>
    <field name="arch" type="xml">
      <xpath expr="//group/group/field[@name='product_id']" position="before">
        <field name="esi_template_id" readonly="state != 'draft' or esi_group_id" options="{'no_create': True}"/>
        <field name="esi_variant_line_mode" readonly="state != 'draft' or esi_group_id" invisible="esi_group_id"/>
        <field name="esi_plan_dirty" invisible="1"/><field name="esi_outputs_dirty" invisible="1"/><field name="esi_allowed_output_ids" invisible="1"/>
        <field name="esi_plan_bom_id" invisible="not esi_variant_line_mode" required="esi_variant_line_mode" readonly="state != 'draft'" options="{'no_create': True}" domain="[('esi_multi_variant', '=', True), ('product_tmpl_id', '=', esi_template_id), ('company_id', 'in', [False, company_id]), ('type', '=', 'normal')]"/>
      </xpath>
      <xpath expr="//group/group/field[@name='product_id']" position="attributes">
        <attribute name="invisible" add="esi_variant_line_mode" separator=" or "/>
        <attribute name="domain">[('is_storable', '=', True)] + ([('product_tmpl_id', '=', esi_template_id)] if esi_template_id else [])</attribute>
        <attribute name="readonly">state != 'draft' or esi_group_id</attribute>
      </xpath>
      <xpath expr="//label[@name='bom_label']" position="attributes"><attribute name="invisible" add="esi_variant_line_mode" separator=" or "/></xpath>
      <xpath expr="//div[@name='bom_div']" position="attributes"><attribute name="invisible" add="esi_variant_line_mode" separator=" or "/></xpath>
      <xpath expr="//div[@name='qty']" position="attributes"><attribute name="invisible" add="(esi_variant_line_mode and state == 'draft')" separator=" or "/></xpath>
      <xpath expr="//div[@name='qty']//field[@name='product_qty']" position="attributes"><attribute name="readonly" add="esi_variant_line_mode" separator=" or "/></xpath>
      <xpath expr="//notebook" position="before">
        <group string="Variantes a fabricar en esta orden" invisible="not esi_variant_line_mode">
          <field name="esi_output_total" string="Total solicitado" class="fw-bold"/>
          <field name="esi_total_output_qty" string="Total del plan vigente" invisible="state == 'draft'"/>
          <field name="esi_output_line_ids" nolabel="1" colspan="2" readonly="state != 'draft'">
            <list editable="bottom">
              <field name="product_id" domain="[('id', 'in', parent.esi_allowed_output_ids)]" options="{'no_create': True}"/>
              <field name="quantity" sum="Total solicitado"/><field name="uom_id" readonly="1"/>
              <field name="planned_qty" readonly="1" column_invisible="parent.state == 'draft'" sum="Total plan vigente"/>
              <field name="produced_qty" readonly="1" column_invisible="parent.state == 'draft'" sum="Total registrado"/>
            </list>
          </field>
          <div class="alert alert-info" colspan="2" invisible="state != 'draft' or not (esi_plan_dirty or esi_outputs_dirty)">Guarde la orden para calcular los materiales y operaciones de todas las tallas.</div>
          <div colspan="2" invisible="state == 'draft'">La lista conserva las cantidades solicitadas. El plan vigente y lo registrado proceden de los movimientos de inventario. Registre también las salidas adicionales antes de finalizar.</div>
        </group>
      </xpath>
      <xpath expr="//notebook" position="attributes"><attribute name="invisible" add="(esi_variant_line_mode and state == 'draft' and (esi_plan_dirty or esi_outputs_dirty))" separator=" or "/></xpath>
      <xpath expr="//field[@name='move_raw_ids']" position="attributes"><attribute name="readonly" add="(esi_variant_line_mode and state == 'draft')" separator=" or "/></xpath>
      <xpath expr="//field[@name='workorder_ids']" position="attributes"><attribute name="readonly" add="(esi_variant_line_mode and state == 'draft')" separator=" or "/></xpath>
      <xpath expr="//field[@name='move_byproduct_ids']" position="attributes"><attribute name="readonly" add="(esi_variant_line_mode and state == 'draft')" separator=" or "/></xpath>
    </field>
  </record>
</odoo>
