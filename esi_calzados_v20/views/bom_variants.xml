<odoo>
  <record id="bom_allowed_variants" model="ir.ui.view">
    <field name="name">mrp.bom.allowed.variants</field><field name="model">mrp.bom</field>
    <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='product_tmpl_id']" position="attributes"><attribute name="widget">esi_recipe_product</attribute></xpath>
      <xpath expr="//field[@name='product_tmpl_id']" position="after">
        <field name="esi_multi_variant" widget="esi_recipe_shared"/>
        <field name="esi_allowed_variant_ids" widget="esi_recipe_variants" invisible="not esi_multi_variant" required="esi_multi_variant" domain="[('product_tmpl_id', '=', product_tmpl_id), ('is_storable', '=', True), ('company_id', 'in', [False, company_id])]" options="{'no_create': True}"/>
      </xpath>
      <xpath expr="//field[@name='product_id']" position="attributes"><attribute name="invisible" add="esi_multi_variant" separator=" or "/></xpath>
    </field>
  </record>
</odoo>
