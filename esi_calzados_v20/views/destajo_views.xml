<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_esi_destajo_list" model="ir.ui.view">
        <field name="name">esi.destajo.list</field>
        <field name="model">esi.destajo</field>
        <field name="arch" type="xml">
            <list string="Destajos">
                <field name="date"/><field name="name"/><field name="production_id"/><field name="group_id" optional="hide"/>
                <field name="operator_id"/><field name="activity"/><field name="quantity"/><field name="unit_price"/><field name="amount_total" sum="Total"/>
            </list>
        </field>
    </record>
    <record id="view_esi_destajo_form" model="ir.ui.view">
        <field name="name">esi.destajo.form</field>
        <field name="model">esi.destajo</field>
        <field name="arch" type="xml">
            <form string="Destajo"><sheet><div class="oe_title"><h1><field name="name"/></h1></div>
                <group><group><field name="date"/><field name="production_id"/><field name="group_id" readonly="1"/><field name="operator_id"/></group>
                <group><field name="activity"/><field name="quantity"/><field name="unit_price"/><field name="amount_total" readonly="1"/><field name="analytic_account_id"/></group></group>
                <field name="note"/></sheet><chatter/></form>
        </field>
    </record>
    <record id="view_esi_destajo_pivot" model="ir.ui.view"><field name="name">esi.destajo.pivot</field><field name="model">esi.destajo</field><field name="arch" type="xml"><pivot string="Análisis de Destajos"><field name="operator_id" type="row"/><field name="activity" type="row"/><field name="date" interval="month" type="col"/><field name="amount_total" type="measure"/><field name="quantity" type="measure"/></pivot></field></record>
    <record id="view_esi_destajo_graph" model="ir.ui.view"><field name="name">esi.destajo.graph</field><field name="model">esi.destajo</field><field name="arch" type="xml"><graph string="Destajos"><field name="operator_id"/><field name="amount_total" type="measure"/></graph></field></record>
    <record id="action_esi_destajo" model="ir.actions.act_window"><field name="name">Destajos</field><field name="res_model">esi.destajo</field><field name="view_mode">list,form,pivot,graph</field></record>
    <menuitem id="menu_esi_destajo" name="Destajos" parent="mrp.menu_mrp_manufacturing" action="action_esi_destajo" sequence="36"/>
</odoo>
