<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_esi_production_group_list" model="ir.ui.view">
        <field name="name">esi.production.group.list</field>
        <field name="model">esi.production.group</field>
        <field name="arch" type="xml">
            <list string="Grupos de fabricación" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="responsible_id"/>
                <field name="analytic_account_id" optional="hide"/>
                <field name="production_count"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_esi_production_group_form" model="ir.ui.view">
        <field name="name">esi.production.group.form</field>
        <field name="model">esi.production.group</field>
        <field name="arch" type="xml">
            <form string="Grupo de fabricación">
                <header>
                    <button name="action_create_productions" type="object" string="Crear órdenes de fabricación" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancelar" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,created,cancel"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_productions" type="object" class="oe_stat_button" icon="fa-industry" invisible="production_count == 0">
                            <field name="production_count" widget="statinfo" string="Órdenes"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group name="manufacturing_details" string="Datos de fabricación">
                            <field name="responsible_id" string="Responsable" readonly="state != 'draft'"/>
                        </group>
                        <group name="company_details" string="Organización y seguimiento">
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="analytic_account_id" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <field name="esi_grid_template_id" invisible="1"/><field name="esi_grid_data" invisible="1"/><field name="esi_grid_changes" invisible="1"/>
                    <separator string="Productos a fabricar"/>
                    <field name="line_ids" readonly="state != 'draft'" nolabel="1" class="w-100">
                        <list editable="bottom">
                            <field name="product_template_id" widget="esi_group_product" string="Producto" readonly="product_id != False" options="{'no_create': True}" domain="[('is_storable', '=', True), ('esi_manufacture_ok', '=', True), ('company_id', 'in', [False, parent.company_id])]"/>
                            <field name="product_id" column_invisible="True"/>
                            <field name="variant_label" string="Variantes" readonly="1"/>
                            <field name="quantity" string="Cantidad"/>
                            <field name="uom_id" string="Unidad"/>
                            <field name="bom_id" string="Lista de materiales" options="{'no_create': True}"/>
                        </list>
                    </field>
                    <separator string="Notas internas"/>
                    <field name="note" nolabel="1" placeholder="Indicaciones para la fabricación…"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_esi_production_group_pivot" model="ir.ui.view">
        <field name="name">esi.production.group.pivot</field>
        <field name="model">esi.production.group</field>
        <field name="arch" type="xml"><pivot string="Análisis de grupos de fabricación"><field name="state" type="row"/><field name="responsible_id" type="row"/><field name="production_count" type="measure"/></pivot></field>
    </record>
    <record id="view_esi_production_group_graph" model="ir.ui.view">
        <field name="name">esi.production.group.graph</field>
        <field name="model">esi.production.group</field>
        <field name="arch" type="xml"><graph string="Grupos de fabricación"><field name="responsible_id"/><field name="production_count" type="measure"/></graph></field>
    </record>
    <record id="action_esi_production_group" model="ir.actions.act_window">
        <field name="name">Grupos de fabricación</field>
        <field name="res_model">esi.production.group</field>
        <field name="view_mode">list,form,pivot,graph</field>
    </record>
    <menuitem id="menu_esi_production_group" name="Grupos de fabricación" parent="mrp.menu_mrp_manufacturing" action="action_esi_production_group" sequence="35"/>
</odoo>
