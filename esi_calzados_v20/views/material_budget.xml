<odoo>
  <record id="production_material_budget" model="ir.ui.view">
    <field name="name">mrp.production.material.budget</field><field name="model">mrp.production</field>
    <field name="inherit_id" ref="mrp.mrp_production_form_view"/><field name="priority">40</field>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="action_esi_material_purchase" type="object" string="Comprar faltantes" invisible="state in ('done', 'cancel')" groups="purchase.group_purchase_user"/>
      </xpath>
      <!-- Campo qty nativo conservado para todas las OF. -->
      <xpath expr="//field[@name='move_raw_ids']/list" position="inside">
        <field name="esi_cost_currency_id" column_invisible="True"/>
        <field name="esi_estimated_unit_cost" optional="show" groups="mrp.group_mrp_manager"/>
        <field name="esi_estimated_cost" optional="show" sum="Total estimado" groups="mrp.group_mrp_manager"/>
      </xpath>
      <xpath expr="//field[@name='move_raw_ids']" position="after">
        <group groups="mrp.group_mrp_manager">
          <field name="esi_budget_currency_id" invisible="1"/>
          <field name="esi_material_estimate"/>
          <div class="text-muted" colspan="2">Estimación al costo actual de los productos en esta compañía, por las cantidades planificadas. No incluye mano de obra, gastos ni impuestos; no sustituye la valoración real.</div>
        </group>
      </xpath>
    </field>
  </record>
  <record id="material_purchase_form" model="ir.ui.view">
    <field name="name">esi.material.purchase.form</field><field name="model">esi.material.purchase</field>
    <field name="arch" type="xml">
      <form string="Comprar materiales faltantes">
        <group><field name="production_id"/><field name="company_id"/></group>
        <div class="alert alert-info">Revise los proveedores. Se creará una solicitud en borrador por proveedor, solo por el faltante actualizado al confirmar. Las cantidades están en la unidad de inventario. Se descuentan las compras pendientes vinculadas a esta OF; las compras generales y recepciones futuras no vinculadas deben revisarse aparte.</div>
        <field name="line_ids"><list editable="bottom" create="0" delete="0">
          <field name="selected"/><field name="product_id"/><field name="uom_id"/>
          <field name="required_qty"/><field name="reserved_qty"/><field name="free_qty"/>
          <field name="pending_qty"/><field name="quantity"/>
          <field name="supplier_id" domain="[('company_id', 'in', [False, parent.company_id])]" options="{'no_create': True}"/>
        </list></field>
        <footer><button name="action_create_rfq" type="object" string="Crear solicitudes de presupuesto" class="btn-primary"/><button special="cancel" string="Cancelar"/></footer>
      </form>
    </field>
  </record>
</odoo>
