<odoo>
  <record id="branch_esi_production_group" model="ir.access">
    <field name="name">Sucursal: esi.production.group</field>
    <field name="model_id" ref="model_esi_production_group"/>
    <field name="operation">crud</field>
    <field name="domain">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="branch_esi_production_group_line" model="ir.access">
    <field name="name">Sucursal: esi.production.group.line</field>
    <field name="model_id" ref="model_esi_production_group_line"/>
    <field name="operation">crud</field>
    <field name="domain">[('group_id.company_id', 'in', company_ids)]</field>
  </record>
  <record id="branch_esi_destajo" model="ir.access">
    <field name="name">Sucursal: esi.destajo</field>
    <field name="model_id" ref="model_esi_destajo"/>
    <field name="operation">crud</field>
    <field name="domain">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="branch_esi_bom_center" model="ir.access">
    <field name="name">Recorrido: compañías autorizadas</field>
    <field name="model_id" ref="model_esi_bom_center"/>
    <field name="operation">crud</field>
    <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
  </record>
</odoo>
