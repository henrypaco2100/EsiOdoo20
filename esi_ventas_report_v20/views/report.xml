<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="report_form" model="ir.ui.view">
    <field name="name">esi.sales.report.form</field>
    <field name="model">esi.sales.report</field>
    <field name="arch" type="xml">
      <form string="Ventas">
        <header>
          <button name="action_preview" type="object" string="Consultar" class="btn-primary"/>
          <button name="action_pdf" type="object" string="PDF"/>
          <button name="action_xlsx" type="object" string="Excel"/>
        </header>
        <sheet>
          <group>
            <field name="company_id"/>
            <field name="report_company_ids" widget="many2many_tags" readonly="1" string="Matriz y sucursales incluidas" options="{'no_open': True}"/><field name="date_from"/>
            <field name="date_to"/>
            <field name="store_id" invisible="1"/>
            <field name="partner_id"/>
          </group>
          <field name="preview" widget="html" nolabel="1"/>
        </sheet>
      </form>
    </field>
  </record>
  <record id="report_action" model="ir.actions.act_window">
    <field name="name">Ventas</field>
    <field name="res_model">esi.sales.report</field>
    <field name="view_mode">form</field>
  </record>
  <menuitem id="report_menu" name="Informe de ventas" action="report_action" groups="sales_team.group_sale_salesman" parent="sale.menu_sale_report" sequence="80"/>
  <record id="report_menu" model="ir.ui.menu">
    <field name="web_icon" eval="False"/>
  </record>
</odoo>
