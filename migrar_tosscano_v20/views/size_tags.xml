<odoo>
    <record id="product_template_size_tags" model="ir.ui.view">
        <field name="name">product.template.tosscano.size.tags</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='attribute_line_ids']/list/field[@name='value_ids']" position="before">
                <field name="tosscano_is_size" column_invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='attribute_line_ids']/list/field[@name='value_ids']" position="attributes">
                <attribute name="widget">tosscano_size_tags</attribute>
            </xpath>
        </field>
    </record>
</odoo>
