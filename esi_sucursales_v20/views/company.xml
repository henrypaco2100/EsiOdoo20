<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_branches" model="ir.actions.act_window">
        <field name="name">Sucursales</field>
        <field name="res_model">res.company</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('parent_id', '!=', False)]</field>
        <field name="context">{'default_parent_id': allowed_company_ids and allowed_company_ids[0] or False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Cree una sucursal de la compañía matriz</p>
            <p>
                Odoo 20 administra las sucursales como compañías hijas. Después de crear o asignar una
                sucursal a un usuario, selecciónela desde el selector nativo de compañía en la parte
                superior derecha para trabajar dentro de esa sucursal.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_branches"
        name="Sucursales"
        parent="base.menu_users"
        action="action_branches"
        sequence="20"
        groups="base.group_system"
    />

    <record id="company_parent_visible" model="ir.ui.view">
        <field name="name">res.company.sucursal.parent.esi.v20</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="attributes">
                <attribute name="groups">base.group_system</attribute>
                <attribute name="string">Compañía matriz / Sucursal superior</attribute>
            </xpath>
        </field>
    </record>

    <record id="users_branches_labels" model="ir.ui.view">
        <field name="name">res.users.sucursales.labels.esi.v20</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_ids']" position="attributes">
                <attribute name="string">Sucursales / Compañías permitidas</attribute>
            </xpath>
            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="string">Sucursal / Compañía predeterminada</attribute>
            </xpath>
        </field>
    </record>
</odoo>
