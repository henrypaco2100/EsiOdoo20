<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Permite delegar la gestión de diarios sin entregar todo el rol de
         Administrador de contabilidad. No concede acceso a otras compañías. -->
    <record id="privilege_esi_journal" model="res.groups.privilege">
        <field name="name">ESI - Diarios contables</field>
        <field name="category_id" ref="base.module_category_accounting"/>
    </record>
    <record id="group_esi_journal_editor" model="res.groups">
        <field name="name">Crear y editar diarios</field>
        <field name="privilege_id" ref="privilege_esi_journal"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_readonly'))]"/>
    </record>
</odoo>
