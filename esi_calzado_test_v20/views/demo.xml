  <record id="demo_form" model="ir.ui.view"><field name="name">esi.calzado.demo.form</field><field name="model">esi.calzado.demo</field><field name="arch" type="xml"><form string="Demo de calzado"><header><button name="action_prepare" type="object" string="Preparar demo" class="btn-primary" invisible="state == 'ready'"/><button name="action_products" type="object" string="Ver tallas" invisible="state != 'ready'"/><button name="action_enable_size_grouping" type="object" string="Habilitar agrupación por talla" invisible="state != 'ready'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="company_id" readonly="state == 'ready'"/><field name="group_id" invisible="not group_id"/></group><div class="alert alert-info">Crea 3 calzados, 72 variantes y cinco centros de trabajo en la sucursal elegida. Los consumos y precios son ficticios para capacitación. No crea existencias, asientos ni órdenes terminadas.</div><notebook><page string="Calzados"><field name="template_ids" readonly="1"/></page><page string="Recetas"><field name="bom_ids" readonly="1"/></page><page string="Etapas"><field name="workcenter_ids" readonly="1"/></page><page string="Materiales"><field name="material_ids" readonly="1"/></page></notebook></sheet></form></field></record>
