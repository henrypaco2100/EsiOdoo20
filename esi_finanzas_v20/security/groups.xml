<odoo>
    <record id="privilege_esi_finance" model="res.groups.privilege">
        <field name="name">Finanzas</field>
        <field name="category_id" ref="base.module_category_accounting"/>
    </record>
    <record id="group_esi_finance" model="res.groups">
        <field name="name">Contador</field>
        <field name="privilege_id" ref="privilege_esi_finance"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_user')), (4, ref('analytic.group_analytic_accounting'))]"/>
    </record>
</odoo>
