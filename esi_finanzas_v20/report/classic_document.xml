<odoo>
  <record id="paper_classic" model="report.paperformat"><field name="name">Financiero estándar A4</field><field name="format">A4</field><field name="orientation">Portrait</field><field name="margin_top">14</field><field name="margin_bottom">14</field><field name="margin_left">8</field><field name="margin_right">8</field><field name="header_spacing">5</field></record>
  <record id="report_classic" model="ir.actions.report"><field name="name">Estado financiero</field><field name="model">esi.finance.report</field><field name="report_type">qweb-pdf</field><field name="report_name">esi_finanzas_v20.document</field><field name="paperformat_id" ref="paper_classic"/><field name="print_report_name">'Estado_financiero_%s' % object.kind</field></record>
  <template id="document"><t t-call="web.html_container"><t t-foreach="payloads" t-as="entry"><t t-set="o" t-value="entry[0]"/><t t-set="p" t-value="entry[1]"/>
    <div class="header" style="font-family:Arial;font-size:10px"><strong t-out="p['company'].name"/><br/>NIT: <span t-out="p['company'].vat or ''"/></div>
    <div class="article" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id"><div class="page" style="font-family:Arial,sans-serif;font-size:10px;color:#202020">
      <h2 style="text-align:center;font-size:17px;margin:8px 0" t-out="p['title']"/><div style="text-align:center;margin-bottom:12px">Expresado en <span t-out="p['currency'].currency_unit_label or p['currency'].name"/> (<span t-out="p['currency'].name"/>)<br/><t t-if="o.kind == 'balance'">Al <span t-out="p['date_to']"/></t><t t-else="">Del <span t-out="p['date_from']"/> al <span t-out="p['date_to']"/></t></div>
      <p style="font-size:9px"><strong>Entidades:</strong> <span t-out="p['scope']"/><br/><strong>Asientos:</strong> <span t-out="'Solo publicados' if p['posted'] else 'Publicados y borradores'"/> · <strong>Diarios:</strong> <span t-out="p['journals']"/><br/><span t-out="p['notes']"/><br t-if="p['comparison']"/><span t-if="p['comparison']">Comparación: <span t-out="p['comparison']"/></span><br t-if="p['partial']"/><span t-if="p['partial']">Informe filtrado: los totales corresponden únicamente a la selección.</span></p>
      <table style="width:100%;border-collapse:collapse;table-layout:auto"><thead style="display:table-header-group"><tr style="background:#e9ecef"><th t-foreach="p['columns']" t-as="column" t-att-style="'border:1px solid #cbd0d5;padding:5px;' + (('width:24%;' if len(p['columns'])>8 else 'width:40%;' if len(p['columns'])>5 else 'width:60%;') if column[0]=='name' else '')" t-out="column[1]"/></tr></thead>
      <tbody><tr t-foreach="p['rows']" t-as="row" t-att-style="'page-break-inside:avoid;' + ('font-weight:bold;' if row['group'] or row.get('style') in ['heading','bold'] else '') + ('text-decoration:underline;' if row.get('style')=='heading' else '') + ('font-style:italic;' if row.get('style')=='italic' else '') + ('font-size:8px;' if row.get('style')=='small' else '') + ('background:#f0f2f4;' if row['summary'] else '')"><t t-foreach="p['columns']" t-as="column"><t t-set="key" t-value="column[0]"/><td t-att-style="'border:1px solid #d8dde1;padding:5px;vertical-align:top;' + ('padding-left:%spx;word-wrap:break-word;' % (8+10*(row['depth']-1)) if key=='name' else ('text-align:right;white-space:nowrap;' if key not in ['code','date','move','journal','company','partner','analytic','origin_currency'] else ''))"><span t-if="key in ['opening','debit','credit','closing','amount','compare','difference','origin_amount'] and row.get(key,'') != ''" t-out="p['fmt'](row[key])"/><span t-else="" t-out="row.get(key,'')"/></td></t></tr></tbody></table>
    </div></div><div class="footer" style="font-family:Arial;font-size:9px;text-align:right">Página <span class="page"/> de <span class="topage"/></div>
  </t></t></template>
</odoo>
