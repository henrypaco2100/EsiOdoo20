<odoo>
  <record id="advanced_wizard_form" model="ir.ui.view"><field name="name">esi.finance.report.advanced</field><field name="model">esi.finance.report</field><field name="inherit_id" ref="classic_wizard_form"/><field name="arch" type="xml">
    <field name="classic_branch_id" position="after"><field name="classic_company_ids" widget="many2many_tags" domain="[('id','child_of',company_id),('id','in',classic_assigned_ids)]" options="{'no_create':True}" invisible="kind not in ['balance','profit','trial','ledger','cashflow']"/></field>
    <field name="kind" position="after"><field name="classic_layout_id" domain="[('kind','=',kind),('company_id','in',classic_assigned_ids)]" invisible="kind not in ['balance','profit']" options="{'no_create':True}"/><field name="classic_currency_id" invisible="kind not in ['balance','profit','trial','ledger','cashflow']"/><field name="classic_currency_method" invisible="kind not in ['balance','profit','trial','ledger','cashflow']"/></field>
    <field name="classic_show_zero" position="attributes"><attribute name="invisible">True</attribute></field>
    <field name="classic_depth" position="after"><field name="classic_display" invisible="kind not in ['balance','profit','trial','ledger','cashflow']"/><field name="classic_debit_credit" invisible="kind not in ['balance','profit']"/><field name="classic_initial" invisible="kind not in ['trial','ledger']"/></field>
    <field name="classic_journal_ids" position="attributes"><attribute name="invisible">kind not in ['balance','profit','trial','ledger','cashflow']</attribute></field>
    <field name="classic_journal_ids" position="after"><field name="classic_excluded_journal_ids" widget="many2many_tags" domain="[('company_id','in',report_company_ids)]" context="{'allowed_company_ids':report_company_ids}" invisible="kind not in ['balance','profit','trial','ledger','cashflow']"/></field>
    <xpath expr="//field[@name='preview']" position="before"><notebook invisible="kind not in ['balance','profit','trial','ledger','cashflow']">
      <page string="Analítica, contactos y flujo"><group><group><field name="classic_analytic_ids" widget="many2many_tags" domain="['|',('company_id','=',False),('company_id','parent_of',report_company_ids)]" context="{'allowed_company_ids':classic_assigned_ids}"/><field name="classic_analytic_mode"/><field name="classic_breakdown_analytic" invisible="kind == 'cashflow'"/><field name="classic_breakdown_partner" invisible="kind == 'cashflow'"/></group><group><field name="classic_partner_ids" widget="many2many_tags"/><field name="classic_flow_activity"/><field name="classic_flow_ids" widget="many2many_tags" domain="['|',('company_id','=',False),('company_id','parent_of',report_company_ids)]" context="{'allowed_company_ids':classic_assigned_ids}"/></group></group><p>Asientos completos conserva todas las contrapartidas que coinciden con los filtros, dentro de las cuentas/diarios seleccionados. Distribución proporcional aplica el porcentaje analítico; puede generar un informe parcial. Los desgloses se muestran como información y no se suman otra vez a los subtotales.</p></page>
      <page string="Comparación" invisible="kind == 'ledger'"><group><field name="classic_compare"/><field name="classic_compare_label" invisible="not classic_compare"/><field name="classic_compare_from" invisible="not classic_compare" required="classic_compare"/><field name="classic_compare_to" invisible="not classic_compare" required="classic_compare"/></group></page>
      <page string="Opciones de flujo" invisible="kind != 'cashflow'"><group><field name="classic_flow_grouping"/></group></page><page string="Opciones del Libro mayor" invisible="kind != 'ledger'"><group><field name="classic_sort"/><field name="classic_ledger_style"/><field name="classic_show_foreign"/></group></page>
    </notebook></xpath>
  </field></record>
  <record id="action_ledger" model="ir.actions.act_window"><field name="target">new</field><field name="context">{'default_kind':'ledger','default_classic_analytic_mode':'entries'}</field></record>
  <record id="action_trial" model="ir.actions.act_window"><field name="context">{'default_kind':'trial','default_classic_analytic_mode':'entries'}</field></record>
<record id="action_cashflow" model="ir.actions.act_window"><field name="target">new</field><field name="context">{'default_kind':'cashflow','default_classic_analytic_mode':'entries'}</field></record></odoo>
