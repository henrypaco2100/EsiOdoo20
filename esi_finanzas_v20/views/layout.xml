<odoo>
  <record id="layout_list" model="ir.ui.view"><field name="name">esi.finance.layout.list</field><field name="model">esi.finance.layout</field><field name="arch" type="xml"><list><header><button name="action_create_standard" type="object" string="Crear estructuras estándar" display="always"/></header><field name="sequence"/><field name="name"/><field name="kind"/><field name="company_id"/><field name="order_by"/><field name="active" optional="hide"/></list></field></record>
  <record id="layout_line_form" model="ir.ui.view"><field name="name">esi.finance.layout.line.form</field><field name="model">esi.finance.layout.line</field><field name="arch" type="xml"><form string="Título del informe"><sheet>
    <group><group><field name="layout_id"/><field name="company_id" readonly="1"/><field name="name"/><field name="code"/><field name="sequence"/><field name="parent_id"/></group><group><field name="mode"/><field name="sign"/><field name="detail" invisible="mode not in ['accounts','account_type']"/><field name="style"/><field name="visible"/></group></group>
    <group string="Selección de cuentas" invisible="mode != 'accounts'"><field name="account_ids" widget="many2many_tags" context="{'active_test':False}"/><field name="include_account_children"/></group>
    <group invisible="mode != 'account_type'"><field name="account_type_ids" widget="many2many_tags" options="{'no_create':True}"/></group>
    <group invisible="mode != 'reference'"><field name="reference_id"/></group>
    <group string="Fórmula: suma y resta de otros títulos" invisible="mode != 'formula'"><field name="term_ids" nolabel="1"><list editable="bottom"><field name="sequence"/><field name="company_id" column_invisible="True"/><field name="source_id" domain="[('company_id','=',parent.company_id)]"/><field name="operation"/></list></field></group>
    <group><field name="excluded_journal_ids" widget="many2many_tags"/></group>
    <p>Conservar signo usa el saldo Débito − Crédito. Invertir signo cambia los saldos presentados, conservando las columnas de débito y crédito de los movimientos. Las fórmulas utilizan el saldo presentado por cada título, evitando sumar sus detalles otra vez.</p>
  </sheet></form></field></record>
  <record id="layout_form" model="ir.ui.view"><field name="name">esi.finance.layout.form</field><field name="model">esi.finance.layout</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="company_id"/><field name="kind"/><field name="sequence"/><field name="order_by"/><field name="active"/></group><field name="line_ids" context="{'default_layout_id':id}" mode="list,form"><list><field name="sequence"/><field name="code"/><field name="name"/><field name="parent_id"/><field name="mode"/><field name="sign"/><field name="detail"/><field name="visible"/></list></field><field name="note" placeholder="Observaciones de la estructura"/></sheet></form></field></record>
  <record id="layout_line_list" model="ir.ui.view"><field name="name">esi.finance.layout.line.list</field><field name="model">esi.finance.layout.line</field><field name="arch" type="xml"><list><field name="layout_id"/><field name="sequence"/><field name="code"/><field name="name"/><field name="parent_id"/><field name="mode"/><field name="company_id"/></list></field></record>
  <record id="layout_action" model="ir.actions.act_window"><field name="name">Estructuras de Balance y Estado de resultados</field><field name="res_model">esi.finance.layout</field><field name="view_mode">list,form</field><field name="help" type="html"><p>Cree una estructura o pulse Crear estructuras estándar. Configure títulos, orden, cuentas, tipos contables, referencias, fórmulas, signo y estilos. El asistente permite elegir la estructura al consultar.</p></field></record>
  <record id="order_menu" model="ir.ui.menu"><field name="name">Reportes financieros</field><field name="action" eval="False"/></record>
  <menuitem id="layout_menu" name="Estructuras de Balance y Resultados" parent="order_menu" action="layout_action" sequence="10" groups="account.group_account_manager"/>
  <menuitem id="simple_order_menu" name="Orden simple por cuentas" parent="order_menu" action="order_action" sequence="20" groups="account.group_account_manager"/>
  <record id="flow_list" model="ir.ui.view"><field name="name">esi.finance.flow.list</field><field name="model">esi.finance.flow</field><field name="arch" type="xml"><list editable="bottom"><field name="sequence"/><field name="code"/><field name="name"/><field name="parent_id"/><field name="flow_type"/><field name="company_id"/></list></field></record>
  <record id="flow_action" model="ir.actions.act_window"><field name="name">Cuentas de flujo financiero</field><field name="res_model">esi.finance.flow</field><field name="view_mode">list,form</field></record>
  <menuitem id="flow_menu" name="Cuentas de flujo" parent="order_menu" action="flow_action" sequence="30" groups="account.group_account_manager"/>
  <record id="financial_flow_line_form" model="ir.ui.view"><field name="name">account.move.line.financial.flow</field><field name="model">account.move.line</field><field name="inherit_id" ref="account.view_move_line_form"/><field name="arch" type="xml"><field name="account_id" position="after"><field name="esi_financial_flow_id" groups="account.group_account_user"/></field></field></record>
</odoo>
