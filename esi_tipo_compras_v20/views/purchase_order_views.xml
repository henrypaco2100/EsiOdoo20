<odoo>
    <record id="view_purchase_order_esi_purchase_type" model="ir.ui.view">
        <field name="name">purchase.order.esi.purchase.type.v20</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="esi_purchase_type_id" options="{'no_create': True}" readonly="state in ('purchase','done','cancel')"/>
            </field>
        <xpath expr="//header" position="inside"><field name="esi_can_register_payment" invisible="1"/><button name="action_esi_register_payment" type="object" string="Registrar pago" invisible="not esi_can_register_payment"/><button name="action_esi_apply_type_flow" type="object" string="Aplicar opciones del tipo" invisible="not esi_purchase_type_id or state not in ('purchase', 'done')"/></xpath></field>
    </record>
</odoo>
