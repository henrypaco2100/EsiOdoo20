<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="report_form" model="ir.ui.view">
    <field name="name">esi.production.report.form</field>
    <field name="model">esi.production.report</field>
    <field name="arch" type="xml">
      <form string="Informes de producción">
        <header>
          <button name="action_preview" type="object" string="Consultar" class="btn-primary"/>
          <button name="action_pdf" type="object" string="PDF"/>
          <button name="action_xlsx" type="object" string="Excel"/>
        </header>
        <sheet>
          <group>
            <group string="Qué desea consultar">
              <field name="company_id"/>
              <field name="production_id" options="{'no_create': True}"/>
              <field name="kind" string="Contenido del informe"/><field name="workcenter_id" options="{'no_create': True}" invisible="kind == 'piecework'"/>
            </group>
            <group string="Filtros de varias órdenes" invisible="production_id">
              <field name="date_basis" invisible="kind == 'piecework'"/>
              <field name="date_from" string="Desde"/><field name="date_to" string="Hasta"/>
              <field name="group_id"/><field name="state_filter"/>
            </group>
          </group>
          <div class="alert alert-info" invisible="production_id">Seleccione la sucursal de las órdenes y, opcionalmente, su centro actual. El centro se obtiene de las etapas en progreso; si no hay, de las listas para iniciar o la primera pendiente.</div>
          <field name="preview" widget="html" nolabel="1"/>
        </sheet>
      </form>
    </field>
  </record>
  <record id="report_action" model="ir.actions.act_window">
    <field name="name">Informes de producción</field>
    <field name="res_model">esi.production.report</field>
    <field name="view_mode">form</field>
  </record>
  <menuitem id="report_menu" name="Informes de producción" parent="mrp.menu_mrp_reporting" action="report_action" groups="mrp.group_mrp_user" sequence="80"/>
  <record id="report_menu" model="ir.ui.menu">
    <field name="web_icon" eval="False"/>
  </record>
<record id="group_report_button" model="ir.ui.view"><field name="name">esi.production.group.report</field><field name="model">esi.production.group</field><field name="inherit_id" ref="esi_calzados_v20.view_esi_production_group_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_production_report" type="object" string="Informe del grupo" invisible="production_count == 0"/></xpath></field></record><record id="production_report_button" model="ir.ui.view"><field name="name">mrp.production.esi.report</field><field name="model">mrp.production</field><field name="inherit_id" ref="mrp.mrp_production_form_view"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_esi_production_report" type="object" string="Informe de fabricación"/></xpath></field></record></odoo>
