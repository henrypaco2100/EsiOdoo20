<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_esi_store_list" model="ir.ui.view">
        <field name="name">esi.store.list</field>
        <field name="model">esi.store</field>
        <field name="arch" type="xml">
            <list string="Tiendas y Sucursales" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="analytic_account_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_esi_store_form" model="ir.ui.view">
        <field name="name">esi.store.form</field>
        <field name="model">esi.store</field>
        <field name="arch" type="xml">
            <form string="Tienda / Sucursal">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        La tienda es una dimensión comercial/analítica. Los almacenes, rutas, reabastecimiento y valoración siguen siendo nativos de Odoo 20.
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="analytic_account_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="warehouse_ids" readonly="1"/>
                            <field name="user_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Notas internas..."/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_esi_store" model="ir.actions.act_window">
        <field name="name">Tiendas / Sucursales</field>
        <field name="res_model">esi.store</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_esi_store" name="Tiendas" parent="sale.menu_sale_config" action="action_esi_store" sequence="85" groups="base.group_no_one"/>
    <record id="menu_esi_store" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
</odoo>
