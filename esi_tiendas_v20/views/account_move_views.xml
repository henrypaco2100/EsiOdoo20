<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_account_move_esi_store" model="ir.ui.view">
        <field name="name">account.move.esi.store.v20</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="esi_store_id" options="{'no_create': True}" readonly="state == 'posted'" invisible="1"/>
                <button name="action_esi_apply_store_analytic" type="object" string="Aplicar analítica de tienda" class="btn-link" invisible="1"/>
            </field>
        </field>
    </record>
</odoo>
