<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_esi_store" model="ir.ui.view">
        <field name="name">purchase.order.esi.store.v20</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="esi_store_id" options="{'no_create': True}" readonly="state in ('purchase','done','cancel')"/>
                <button name="action_esi_apply_store_analytic" type="object" string="Aplicar analítica de tienda"
                        class="btn-link" invisible="not esi_store_id"/>
            </field>
        </field>
    </record>
</odoo>
