<?xml version='1.0' encoding='utf-8'?>
<odoo>
<record id="chat_list" model="ir.ui.view"><field name="name">esi.ai.conversation.list</field><field name="model">esi.ai.conversation</field><field name="arch" type="xml"><list><field name="name"/><field name="area"/><field name="store_id" invisible="1"/><field name="user_id"/><field name="message_count"/><field name="write_date"/></list></field></record>
<record id="chat_form" model="ir.ui.view"><field name="name">esi.ai.conversation.form</field><field name="model">esi.ai.conversation</field><field name="arch" type="xml"><form><header><button name="action_send" type="object" string="Enviar consulta" class="btn-primary"/><button name="action_execute" type="object" string="Ejecutar propuesta" invisible="not proposal" confirm="Revise la propuesta. Esta acción creará una cotización o confirmará la venta indicada con su usuario."/><button name="action_discard" type="object" string="Descartar propuesta" invisible="not proposal"/><button name="action_open_sale" type="object" string="Abrir venta" invisible="not sale_id"/><button name="action_sales_report" type="object" string="Informe de ventas" invisible="area != 'sales'"/></header><sheet><group><field name="name"/><field name="area" readonly="id"/><field name="store_id" readonly="id" invisible="1"/><field name="user_id"/><field name="company_id"/></group><field name="message_ids" nolabel="1"><list create="0" edit="0" delete="0"><field name="create_date"/><field name="role"/><field name="content"/></list><form><sheet><field name="role"/><field name="content" nolabel="1"/></sheet></form></field><group string="Propuesta para revisar" invisible="not proposal"><field name="proposal" invisible="1"/><field name="proposal_summary" nolabel="1"/><field name="sale_id" invisible="1"/></group><group string="Escriba su consulta"><field name="prompt" nolabel="1" placeholder="Consulta de esta área. Los datos consultados se envían a OpenAI."/></group></sheet></form></field></record>
<record id="chat_pivot" model="ir.ui.view"><field name="name">esi.ai.conversation.pivot</field><field name="model">esi.ai.conversation</field><field name="arch" type="xml"><pivot><field name="area" type="row"/><field name="message_count" type="measure"/><field name="input_tokens" type="measure"/><field name="output_tokens" type="measure"/></pivot></field></record>
<record id="chat_graph" model="ir.ui.view"><field name="name">esi.ai.conversation.graph</field><field name="model">esi.ai.conversation</field><field name="arch" type="xml"><graph><field name="area"/><field name="message_count" type="measure"/></graph></field></record>
<menuitem id="root" name="Agente IA" groups="group_esi_ai_user" web_icon="esi_agente_ia_v20,static/description/icon.png"/>
<record id="action_global" model="ir.actions.act_window"><field name="name">Chat Global</field><field name="res_model">esi.ai.conversation</field><field name="view_mode">list,form</field><field name="domain">[('area','=','global')]</field><field name="context">{'default_area':'global'}</field></record><menuitem id="menu_global" name="Global" parent="root" action="action_global" sequence="1"/><record id="action_sales" model="ir.actions.act_window"><field name="name">Chat Ventas</field><field name="res_model">esi.ai.conversation</field><field name="view_mode">list,form</field><field name="domain">[('area','=','sales')]</field><field name="context">{'default_area':'sales'}</field></record><menuitem id="menu_sales" name="Ventas" parent="root" action="action_sales" sequence="2"/><record id="action_purchase" model="ir.actions.act_window"><field name="name">Chat Compras</field><field name="res_model">esi.ai.conversation</field><field name="view_mode">list,form</field><field name="domain">[('area','=','purchase')]</field><field name="context">{'default_area':'purchase'}</field></record><menuitem id="menu_purchase" name="Compras" parent="root" action="action_purchase" sequence="3"/><record id="action_inventory" model="ir.actions.act_window"><field name="name">Chat Inventario</field><field name="res_model">esi.ai.conversation</field><field name="view_mode">list,form</field><field name="domain">[('area','=','inventory')]</field><field name="context">{'default_area':'inventory'}</field></record><menuitem id="menu_inventory" name="Inventario" parent="root" action="action_inventory" sequence="4"/><record id="action_importation" model="ir.actions.act_window"><field name="name">Chat Importación</field><field name="res_model">esi.ai.conversation</field><field name="view_mode">list,form</field><field name="domain">[('area','=','importation')]</field><field name="context">{'default_area':'importation'}</field></record><menuitem id="menu_importation" name="Importación" parent="root" action="action_importation" sequence="5"/><record id="action_manufacturing" model="ir.actions.act_window"><field name="name">Chat Fabricación</field><field name="res_model">esi.ai.conversation</field><field name="view_mode">list,form</field><field name="domain">[('area','=','manufacturing')]</field><field name="context">{'default_area':'manufacturing'}</field></record><menuitem id="menu_manufacturing" name="Fabricación" parent="root" action="action_manufacturing" sequence="6"/><record id="action_pos" model="ir.actions.act_window"><field name="name">Chat POS</field><field name="res_model">esi.ai.conversation</field><field name="view_mode">list,form</field><field name="domain">[('area','=','pos')]</field><field name="context">{'default_area':'pos'}</field></record><menuitem id="menu_pos" name="POS" parent="root" action="action_pos" sequence="7"/><record id="action_accounting" model="ir.actions.act_window"><field name="name">Chat Contabilidad</field><field name="res_model">esi.ai.conversation</field><field name="view_mode">list,form</field><field name="domain">[('area','=','accounting')]</field><field name="context">{'default_area':'accounting'}</field></record><menuitem id="menu_accounting" name="Contabilidad" parent="root" action="action_accounting" sequence="8"/><record id="action_dashboard" model="ir.actions.act_window"><field name="name">Tablero IA</field><field name="res_model">esi.ai.conversation</field><field name="view_mode">graph,pivot,list,form</field></record><menuitem id="menu_dashboard" name="Tablero" parent="root" action="action_dashboard" sequence="50"/><record id="action_report" model="ir.actions.act_window"><field name="name">Informe IA</field><field name="res_model">esi.ai.conversation</field><field name="view_mode">pivot,graph,list,form</field></record><menuitem id="menu_report" name="Informe" parent="root" action="action_report" sequence="50"/></odoo>
