<odoo><record id="group_esi_ai_user" model="res.groups"><field name="name">ESI: Usuario Agente IA</field><field name="implied_ids" eval="[(4,ref('base.group_user'))]"/></record>
<record id="conversation_own" model="ir.access"><field name="name">IA: solo conversaciones propias y compañías autorizadas</field><field name="model_id" ref="model_esi_ai_conversation"/><field name="domain">[('user_id','=',user.id),('company_id','in',company_ids)]</field><field name="operation">crud</field></record>
<record id="message_own" model="ir.access"><field name="name">IA: solo mensajes propios</field><field name="model_id" ref="model_esi_ai_message"/><field name="domain">[('conversation_id.user_id','=',user.id),('conversation_id.company_id','in',company_ids)]</field><field name="operation">crud</field></record></odoo>
